{
  "_comment": [
    "A sanitized stand-in for what `mu300-vpn gen` produces for a VLESS + Reality",
    "profile. Every credential below is a placeholder.",
    "Generate the real thing on your own device:",
    "    MU300_VPN_RUN=/tmp/gen mu300-vpn gen",
    "    cat /tmp/gen/config.json",
    "then feed it to gen-split-config.py --base.",
    "Note the fields the device injects that are easy to get wrong by hand:",
    "  * the DNS entry uses type+tcp with detour=proxy, final=remote, strategy=ipv4_only",
    "  * packet_encoding=xudp",
    "  * domain_resolver=bootstrap, matched by the second DNS server's tag",
    "  * route.default_mark=720 and auto_detect_interface=true"
  ],

  "log": { "level": "warn", "timestamp": false },

  "dns": {
    "servers": [
      { "type": "tcp", "tag": "remote", "server": "1.1.1.1", "detour": "proxy" },
      { "type": "udp", "tag": "bootstrap", "server": "1.1.1.1" }
    ],
    "final": "remote",
    "strategy": "ipv4_only"
  },

  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "stack": "gvisor",
      "interface_name": "sbtun",
      "address": ["172.19.0.1/30"],
      "mtu": 1400,
      "auto_route": true,
      "strict_route": true,
      "route_exclude_address": ["192.168.77.0/24"]
    }
  ],

  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": "223.0.103.1",
      "server_port": 443,
      "uuid": "00000000-0000-4000-8000-000000000000",
      "flow": "xtls-rprx-vision",
      "packet_encoding": "xudp",
      "domain_resolver": "bootstrap",
      "tls": {
        "enabled": true,
        "server_name": "www.example.com",
        "utls": { "enabled": true, "fingerprint": "chrome" },
        "reality": {
          "enabled": true,
          "public_key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "short_id": "0123abcd"
        }
      }
    },
    { "type": "direct", "tag": "direct" }
  ],

  "route": {
    "rules": [
      { "action": "sniff" },
      { "protocol": "dns", "action": "hijack-dns" },
      { "source_ip_cidr": ["192.168.77.0/24"], "ip_is_private": true, "action": "reject" },
      { "ip_is_private": true, "outbound": "direct" }
    ],
    "final": "proxy",
    "auto_detect_interface": true,
    "default_mark": 720,
    "default_domain_resolver": "bootstrap"
  }
}
